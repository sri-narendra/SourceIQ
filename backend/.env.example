# ==========================================
# Application
# ==========================================

APP_NAME=AI Knowledge Platform
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# ==========================================
# Security
# ==========================================

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SECRET_KEY=change-me

# ==========================================
# CORS
# ==========================================

FRONTEND_URL=http://localhost:3000

# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_knowledge

# ==========================================
# Redis (Optional)
# ==========================================

REDIS_URL=redis://localhost:6379/0

# ==========================================
# AI Provider
# ==========================================

AI_PROVIDER=gemini
# gemini | groq | openai | mistral | nvidia | openrouter | vllm | ollama

GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VLLM_BASE_URL=http://localhost:8001/v1
OLLAMA_BASE_URL=http://localhost:11434

EMBEDDING_MODEL=text-embedding-004

# ==========================================
# Upload Limits
# ==========================================

MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,docx,pptx,xlsx,odt,txt,md,csv,tsv,json,xml,html,yaml,yml,rtf,py,js,ts,java,cpp,go,rs,rb,php,swift,kt,sh,log,png,jpg,jpeg,bmp,tif,tiff,webp

# ==========================================
# AWS
# ==========================================

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
SQS_QUEUE_URL=

# ==========================================
# Logging
# ==========================================

LOG_LEVEL=INFO